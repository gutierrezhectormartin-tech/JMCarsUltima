@model JMCarsWeb.ViewModels.UsuariosViewModel
@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="container mt-4">
    <div class="mb-4">
        <div>
            <h2 class="mb-1">Gestión de usuarios</h2>
            <p class="text-muted">Puede activar o inactivar las cuentas de clientes y escribanos</p>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <h4 class="mt-4 mb-3"><i class="bi bi-people me-2"></i>Clientes</h4>

    @if (Model.Clientes == null || !Model.Clientes.Any())
    {
        <div class="card card-body p-5 text-center">
            <i class="bi bi-people text-muted" style="font-size: 2.5rem"></i>
            <h5 class="mt-3">No hay clientes registrados</h5>
            <p class="text-muted mb-0">Cuando haya clientes registrados podras visualizarlos aqui</p>
        </div>
    }
    else
    {
        <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Cédula</th>
                        <th>Contacto</th>
                        <th>Fecha de Registro</th>
                        <th>Estado</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Clientes)
                    {
                        <tr>
                            <td><div class="fw-bold" style="color: var(--jm-azul);">@c.NombreCompleto</div></td>
                            <td>@c.Cedula</td>
                            <td>
                                <div>@c.Email</div>
                                <div class="text-muted small">@c.Telefono</div>
                            </td>
                            <td class="text-muted">@c.FechaAceptacionTerminos?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (c.EstadoUsu)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i>Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-slash-circle"></i>Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-controller="Admin" asp-action="HistorialPublicaciones" asp-route-idCliente="@c.IdUsuario" class="btn btn-outline-primary btn-sm" title="Ver Publicaciones">
                                    <i class="bi bi-car-front"></i> Publicaciones
                                </a>
                                @if (c.EstadoUsu)
                                {
                                    <form asp-controller="Admin" asp-action="InactivarCliente" method="post" data-confirmar="¿Inactivar cuenta de usuario @c.NombreCompleto?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.IdUsuario" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Inactivar">
                                            <i class="bi bi-slash-circle"></i> Inactivar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Admin" asp-action="ActivarCliente" method="post" data-confirmar="¿Desea activar la cuenta de @c.NombreCompleto?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.IdUsuario" />
                                        <button type="submit" class="btn btn-outline-success btn-sm" title="Activar">
                                            <i class="bi bi-check-circle"></i> Activar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
    }

    <h4 class="mt-5 mb-3"><i class="bi bi-briefcase me-2"></i>Escribanos</h4>

    @if (Model.Escribanos == null || !Model.Escribanos.Any())
    {
        <div class="card card-body p-5 text-center">
            <i class="bi bi-briefcase text-muted" sryle="font-size: 2.5rem;"></i>
            <h5 class="mt-3">No hay escribanos registrados</h5>
            <p class="text-muted mb-0">Cuando haya escribanos registrados podras visualizarlos aqui</p>
        </div>
    }
    else
    {
        <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Escribano</th>
                        <th>Caja Profesional</th>
                        <th>Dirección del Estudio</th>
                        <th>Contacto</th>
                        <th>Estado</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Escribanos)
                    {
                        <tr>
                            <td><div class="fw-bold" style="color: var(--jm-azul);">@e.NombreCompleto</div></td>
                            <td>@e.NumeroCaja</td>
                            <td>@e.Direccion</td>
                            <td>
                                <div>@e.Email</div>
                                <div class="text-muted small">@e.Telefono</div>
                            </td>
                            <td>
                                @if (e.EstadoUsu)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i>Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-slash-circle"></i>Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (e.EstadoUsu)
                                {
                                    <form asp-controller="Admin" asp-action="InactivarEscribano" method="post" data-confirmar="¿Inactivar cuenta de usuario @e.NombreCompleto?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@e.IdUsuario" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Inactivar">
                                            <i class="bi bi-slash-circle"></i> Inactivar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Admin" asp-action="ActivarEscribano" method="post" data-confirmar="¿Desea activar la cuenta de @e.NombreCompleto?">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@e.IdUsuario" />
                                        <button type="submit" class="btn btn-outline-success btn-sm" title="Activar">
                                            <i class="bi bi-check-circle"></i> Activar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
    }
</div>

<div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow overflow-hidden">
            <div class="modal-header" style="background-color: var(--jm-azul); color: #fff">
                <h5 class="modal-title"><i class="bi bi-question-circle me-2"></i>Confirme la accion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalConfirmarTexto"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnModalConfirmar">Confirmar</button>

            </div>
        </div>

    </div>

</div>

@section Scripts{

    <script>
        
        var modalConfirmar = new bootstrap.Modal(document.getElementById('modalConfirmar'));
        var formPendiente = null;

        //aca paro los formularios, para pedirle una confirmacion al cliente o escribano o quien sea
        document.querySelectorAll('form[data-confirmar]').forEach(function (form) {
            form.addEventListener('submit', function (e){
                e.preventDefault();
                formPendiente = form;
                document.getElementById('modalConfirmarTexto').textContent = form.dataset.confirmar;
                modalConfirmar.show();
            });
        }); 

        //aca envio el formulario si le dan boton confirmar, y lo desabilito para que no le den dos veces
        document.getElementById('btnModalConfirmar').addEventListener('click', function(){
            this.disabled = true;
            if(formPendiente)
            {
                formPendiente.submit();
            }
        });
    </script>
}
