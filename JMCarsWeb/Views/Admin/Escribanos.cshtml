@model List<JMCarsWeb.DTOs.EscribanoDTO>
@{
    ViewData["Title"] = "Escribanos pendientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Escribanos pendientes de aprobación</h2>
            <p class="text-muted mb-0">Verifique la condición profesional del escribano antes de activar su cuenta</p>
        </div>
    </div>

    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> No hay escribanos pendientes de aprobación
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Escribano</th>
                        <th>Caja Profesional</th>
                        <th>Dirección del Estudio</th>
                        <th>Contacto</th>
                        <th>Fecha de Registro</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><strong>@e.NombreCompleto</strong></td>
                            <td>@e.NumeroCaja</td>
                            <td>@e.Direccion</td>
                            <td>
                                <div>@e.Email</div>
                                <div class="text-muted small">@e.Telefono</div>
                            </td>
                            <td>@e.FechaAceptacionTerminos?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                <form asp-controller="Admin" asp-action="ActivarEscribano" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@e.IdUsuario" />
                                    <button type="submit" class="btn btn-outline-success btn-sm" title="Aprobar">
                                        <i class="bi bi-check-circle"></i> Aprobar
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
