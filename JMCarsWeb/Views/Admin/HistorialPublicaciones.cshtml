@model JMCarsWeb.ViewModels.HistorialPublicacionesViewModel
@{
    ViewData["Title"] = "Historial de Publicaciones";
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a usuarios
        </a>
    </div>
    <div class="mb-4">
        <h2 class="mb-1">Historial de Publicaciones</h2>
        @if(!string.IsNullOrWhiteSpace(Model.NombreCliente))
        {
            <div class="text-muted">Cliente: @Model.NombreCliente</div>
        }
    </div>

    @if(TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if(TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    <form asp-controller="Admin" asp-action="HistorialPublicaciones" method="get" class="row g-2 mb-3">
        <input type="hidden" name="idCliente" value="@Model.IdCliente"/>
        <div class="col-md-5">
            <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Marca modelo o año"/>
        </div>
        <div class="col-md-3">
            <select name="estado" class="form-select">
                <option value="">Todos</option>
                <option value="1" selected="@(Model.Estado == 1)">Pendiente</option>
                <option value="2" selected="@(Model.Estado == 2)">Aprobada</option>
                <option value="3" selected="@(Model.Estado == 3)">Rechazada</option>
                <option value="4" selected="@(Model.Estado == 4)">Inactiva</option>
                <option value="5" selected="@(Model.Estado == 5)">En Tramite</option>
                <option value="6" selected="@(Model.Estado == 6)">Vendido</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-controller="Admin" asp-action="HistorialPublicaciones" asp-route-idCliente="@Model.IdCliente" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="text-muted small mb-2">@Model.TotalFiltrados resultados(s)</div>

    @if(Model.Vehiculos == null || !Model.Vehiculos.Any())
    {
        <div class="card card-body p-5 text-center">
            <i class="bi bi-car-front text-muted" style="font-size: 2.5rem"></i>
            @if(Model.Estado.HasValue || !string.IsNullOrWhiteSpace(Model.Buscar))
            {
                <h5 class="mt-3">No existen publicaciones con estos filtros</h5>
                <p class="text-muted mb-0">Proba con otros filtros o limpia los mismos</p>
            }
            else
            {
                <h5 class="mt-3">Este cliente no tiene publicaciones</h5>
                <p class="text-muted mb-0">Cuando publique, podras ver sus publicaciones aqui</p>
            }
        </div>
    }
    else
    {
        <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Vehiculo</th>
                        <th>Año</th>
                        <th>Km</th>
                        <th>Precio</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var v in Model.Vehiculos)
                    {
                        <tr>
                            <td><div class="fw-bold" style="color: var(--jm-azul);">@v.Modelo?.Marca?.NombreMarca @v.Modelo?.Modelo</div></td>
                            <td>@v.Anio</td>
                            <td>@v.Km.ToString("N0")</td>
                            <td><span class="fw-bold" style="color: var(--jm-azul)">U$S @v.Precio.ToString("N0")</span></td>
                            <td>
                                @if(v.IdEstadoPublicacion == 1)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i>Pendiente</span>
                                }
                                else if(v.IdEstadoPublicacion == 2)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i>Aprobada</span>
                                }
                                else if(v.IdEstadoPublicacion == 3)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i>Rechazada</span>
                                }
                                else if (v.IdEstadoPublicacion == 4)
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-slash-circle"></i>Inactiva</span>
                                }
                                else if (v.IdEstadoPublicacion == 5)
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-hourglass-split"></i>En Tramite</span>
                                }
                                else if (v.IdEstadoPublicacion == 6)
                                {
                                    <span class="badge bg-dark"><i class="bi bi-bag-check"></i>Vendido</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
        <partial name="_Paginador" model="Model.Vehiculos"/>
    }
</div>
