@model List<JMCarsWeb.DTOs.VehiculoDTO>
@{
    ViewData["Title"] = "Historial de Publicaciones";
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a usuarios
        </a>
    </div>
    <div class="mb-4">
        <h2 class="mb-1">Historial de Publicaciones</h2>
        @if(Model.Any())
        {
            <div class="text-muted">Cliente: @Model.First().Vendedor?.NombreCompleto</div>
        }
    </div>

    @if(TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if(TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    @if(!Model.Any())
    {
        <div class="card card-body p-5 text-center">
            <i class="bi bi-car-front text-muted" style="font-size: 2.5rem"></i>
            <h5 class="mt-3">Este cliente no tiene publicaciones</h5>
            <p class="text-muted mb-0">Cuando publique, podras ver sus publicaciones aqui</p>
        </div>
    }
    else
    {
        <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Vehiculo</th>
                        <th>Año</th>
                        <th>Km</th>
                        <th>Precio</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var v in Model)
                    {
                        <tr>
                            <td><div class="fw-bold" style="color: var(--jm-azul);">@v.Modelo?.Marca?.NombreMarca @v.Modelo?.Modelo</div></td>
                            <td>@v.Anio</td>
                            <td>@v.Km.ToString("N0")</td>
                            <td><span class="fw-bold" style="color: var(--jm-azul)">U$S @v.Precio.ToString("N0")</span></td>
                            <td>
                                @if(v.IdEstadoPublicacion == 1)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i>Pendiente</span>
                                }
                                else if(v.IdEstadoPublicacion == 2)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i>Aprobada</span>
                                }
                                else if(v.IdEstadoPublicacion == 3)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i>Rechazada</span>
                                }
                                else if (v.IdEstadoPublicacion == 4)
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-slash-circle"></i>Inactiva</span>
                                }
                                else if (v.IdEstadoPublicacion == 5)
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-hourglass-split"></i>En Tramite</span>
                                }
                                else if (v.IdEstadoPublicacion == 6)
                                {
                                    <span class="badge bg-dark"><i class="bi bi-bag-check"></i>Vendido</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
    }
</div>
