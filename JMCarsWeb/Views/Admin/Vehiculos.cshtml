@model List<JMCarsWeb.DTOs.VehiculoDTO>
@{
    ViewData["Title"] = "Administracion de Publicaciones";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Panel de Administracion de Publicaciones</h2>
            <p class="text-muted mb-0">Puede aprobar o rechazar las publicaciones en la plataforma</p>
        </div>
    </div>

    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle">No existen vehiculos registrados</i>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 90px;">Foto</th>
                        <th>Vehiculo</th>
                        <th>Vendedor</th>
                        <th>Precio</th>
                        <th>Km</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td>
                                 @if(v.Fotografia != null && v.Fotografia.Any())
                                {
                                    string primeraFoto = v.Fotografia.FirstOrDefault().Replace("\\", "/");
                                    string rutafinal = primeraFoto.StartsWith("/") ? primeraFoto : "/" + primeraFoto;
                                    <img src="@rutafinal" alt="Foto Vehiculo" style="width: 80px; height: 50px; object-fit: cover;" class="img-thumbnail"/>
                                }
                                else
                                {
                                    <span class="text-muted small">No hay fotografía</span>
                                }
                            </td>
                            <td>
                                <strong>@v.Modelo?.Marca?.NombreMarca @v.Modelo?<div class="Modelo"></div></strong>
                                <div class="text-muted small">Año: @v.Anio</div>
                            </td>
                            <td>@v.Vendedor.NombreCompleto</td>
                            <td><span class="text-success fw-bold">U$S @v.Precio.ToString("N0")</span></td>
                            <td>@v.Km.ToString("N0")</td>
                            <td class="text-center">
                                @if(v.Publicado)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i>Publicado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-slash-circle"></i>Inactivo</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    @if(v.Publicado)
                                    {
                                        <form asp-controller="Admin" asp-action="CambiarEstado" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@v.IdVehiculo"/>
                                            <input type="hidden" name="publicado" value="true"/>
                                            <button type="submit" class="btn btn-outline-warning btn-sm" title="Rechazar">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin" asp-action="CambiarEstado" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@v.IdVehiculo" />
                                            <input type="hidden" name="publicado" value="false" />
                                            <button type="submit" class="btn btn-outline-success btn-sm" title="Aprobar">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </div>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    }

</div>