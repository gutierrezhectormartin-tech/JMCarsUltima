@model JMCarsWeb.DTOs.VehiculoDTO
@{
    ViewData["Title"] = "Solicitar Escribano";
    var escribanos = ViewBag.Escribanos as List<JMCarsWeb.DTOs.EscribanoDTO>;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Solicitar Escribano</h2>
            <p class="text-muted mb-0">Elegí el escribano que va a gestionar la compraventa</p>
        </div>
        <a href="@Url.Action("Detalle", "Vehiculo", new { id = Model.IdVehiculo })" class="btn btn-outline-secondary">
            Volver al vehículo
        </a>
    </div>

    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">
                @Model.Modelo?.Marca?.NombreMarca @Model.Modelo?.Modelo @Model.Anio
            </h5>
            <p class="card-text mb-1">
                <strong>Precio:</strong> USD @Model.Precio.ToString("N0")
            </p>
            <p class="card-text text-muted mb-0">
                <strong>Vendedor:</strong> @Model.Vendedor?.NombreCompleto
            </p>
        </div>
    </div>

    <form asp-action="Solicitar" method="post">
        <input type="hidden" name="idVehiculo" value="@Model.IdVehiculo" />

        <div class="mb-3">
            <label for="idEscribano" class="form-label">Escribano</label>
            <select name="idEscribano" id="idEscribano" class="form-select" required>
                <option value="">-- Seleccioná un escribano --</option>
                @if (escribanos != null)
                {
                    @foreach (var escribano in escribanos)
                    {
                        <option value="@escribano.IdUsuario">
                            @escribano.NombreCompleto - Caja @escribano.NumeroCaja (@escribano.Direccion)
                        </option>
                    }
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Enviar Solicitud</button>
    </form>
</div>
