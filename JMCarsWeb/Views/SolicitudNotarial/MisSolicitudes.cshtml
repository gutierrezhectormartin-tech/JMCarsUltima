@model JMCarsWeb.ViewModels.MisSolicitudesViewModel
@{
    ViewData["Title"] = "Mis Solicitudes";
}
<div class="container mt-4">

        <div class="mb-4">
            <h2 class="mb-1">Mis Solicitudes Notariales</h2>
            <p class="text-muted">Estado de los escribanos que solicitaste</p>
        </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-controller="SolicitudNotarial" asp-action="MisSolicitudes" method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Vehiculo o Escribano"/>
        </div>
        <div class="col-md-3">
            <select name="estado" class="form-select">
                <option value="">Todos los estados</option>
                <option value="1" selected="@(Model.Estado == 1)">Pendiente</option>
                <option value="2" selected="@(Model.Estado == 2)">Aceptada</option>
                <option value="3" selected="@(Model.Estado == 3)">Rechazada</option>
                <option value="4" selected="@(Model.Estado == 4)">Finalizada</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-controller="SolicitudNotarial" asp-action="MisSolicitudes" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="text-muted small mb-2">@Model.TotalFiltrados resultado(s)</div>

    @if (Model.Solicitudes == null || !Model.Solicitudes.Any())
    {
        <div class="card card-body p-5 text-center">
            <i class="bi bi-file-earmark-text text-muted" style="font-size: 2.5rem;"></i>
            @if(Model.Estado.HasValue || !string.IsNullOrWhiteSpace(Model.Buscar))
            {
                <h5 class="mt-3">No hay solicitudes con estos filtros</h5>
                <p class="text-muted mb-0">Proba con otra combinacion de filtros o limpia los filtros</p>
            }
            else
            {
                <h5 class="mt-3">Todavía no solicitaste ningún escribano</h5>
                <p class="text-muted">Cuando estes hablando con un vendedor, podes solicitar desde alli el escribano</p>
                <div>
                    <a asp-controller="Chat" asp-action="Historial" class="btn btn-primary">
                        <i class="bi bi-chat-dots"></i>Ir a Mis Conversaciones
                    </a>
                </div>
            }
            

        </div>
    }
    else
    {
        <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Vehículo</th>
                        <th>Escribano</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Solicitudes)
                    {
                        var solicitud = item.Solicitud;
                        var vehiculo = solicitud?.Vehiculo;

                        string textoEstado;
                        string claseEstado;

                        switch (solicitud?.EstadoSolicitud)
                        {
                            case 1:
                                textoEstado = "Pendiente";
                                claseEstado = "bg-warning text-dark";
                                break;
                            case 2:
                                textoEstado = "Aceptada";
                                claseEstado = "bg-success";
                                break;
                            case 3:
                                textoEstado = "Rechazada";
                                claseEstado = "bg-danger";
                                break;
                            case 4:
                                textoEstado = "Finalizada";
                                claseEstado = "bg-primary";
                                break;
                            default:
                                textoEstado = "Desconocido";
                                claseEstado = "bg-secondary";
                                break;
                        }

                        <tr>
                            <td>
                                <div class="fw-bold" style="color: var(--jm-azul)">@vehiculo?.Modelo?.Marca?.NombreMarca @vehiculo?.Modelo?.Modelo @vehiculo?.Anio</div>
                                <div class="text-muted small">Vendedor: @vehiculo?.Vendedor?.NombreCompleto</div>
                            </td>
                            <td>
                                <div class="fw-bold">@item.Escribano?.NombreCompleto</div>
                                <div class="text-muted small">@item.Escribano?.Email</div>
                                @if(solicitud?.EstadoSolicitud == 2)
                                {
                                    <div class="small"><i class="bi bi-telephone me-1"></i>@item.Escribano?.Telefono</div>
                                }
                            </td>
                            <td class="text-muted">@solicitud?.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge @claseEstado">@textoEstado</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
        <partial name="_Paginador" model="Model.Solicitudes" />
    }
</div>
