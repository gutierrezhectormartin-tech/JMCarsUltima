@model List<JMCarsWeb.DTOs.SolicitudEscribanoDTO>
@{
    ViewData["Title"] = "Solicitudes Recibidas";
    var compraVentaPorSolicitud = ViewBag.CompraVentaPorSolicitud as Dictionary<int, JMCarsWeb.DTOs.CompraVentaDTO>;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Solicitudes Recibidas</h2>
            <p class="text-muted mb-0">Solicitudes de compraventa asignadas a usted</p>
        </div>
    </div>

    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            Todavía no recibiste solicitudes.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Vehículo</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th class="text-center">Solicitud</th>
                        <th class="text-center">Compraventa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var solicitud = item.Solicitud;
                        var vehiculo = solicitud?.Vehiculo;

                        string textoEstado;
                        string claseEstado;

                        switch (solicitud?.EstadoSolicitud)
                        {
                            case 1:
                                textoEstado = "Pendiente";
                                claseEstado = "bg-warning text-dark";
                                break;
                            case 2:
                                textoEstado = "Aceptada";
                                claseEstado = "bg-success";
                                break;
                            case 3:
                                textoEstado = "Rechazada";
                                claseEstado = "bg-danger";
                                break;
                            default:
                                textoEstado = "Desconocido";
                                claseEstado = "bg-secondary";
                                break;
                        }

                        JMCarsWeb.DTOs.CompraVentaDTO compraVenta = compraVentaPorSolicitud != null && compraVentaPorSolicitud.ContainsKey(solicitud.IdSolicitud)
                            ? compraVentaPorSolicitud[solicitud.IdSolicitud]
                            : null;

                        <tr>
                            <td>
                                <strong>@vehiculo?.Modelo?.Marca?.NombreMarca @vehiculo?.Modelo?.Modelo @vehiculo?.Anio</strong>
                                <div class="text-muted small">Vendedor: @vehiculo?.Vendedor?.NombreCompleto</div>
                            </td>
                            <td>
                                @solicitud?.Cliente?.NombreCompleto
                                <div class="text-muted small">@solicitud?.Cliente?.Email</div>
                            </td>
                            <td>@solicitud?.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>

                            <!-- Columna Solicitud -->
                            <td class="text-center">
                                <span class="badge @claseEstado mb-2 d-block">@textoEstado</span>
                                @if (solicitud?.EstadoSolicitud == 1)
                                {
                                    <div class="btn-group btn-group-sm" role="group">
                                        <form asp-action="Aceptar" method="post" class="d-inline">
                                            <input type="hidden" name="idSolicitud" value="@solicitud.IdSolicitud" />
                                            <button type="submit" class="btn btn-outline-success" title="Aceptar">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Rechazar" method="post" class="d-inline">
                                            <input type="hidden" name="idSolicitud" value="@solicitud.IdSolicitud" />
                                            <button type="submit" class="btn btn-outline-danger" title="Rechazar">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>

                            <!-- Columna Compraventa -->
                            <td class="text-center">
                                @if (compraVenta == null)
                                {
                                    <span class="text-muted small">—</span>
                                }
                                else if (compraVenta.EstadoCompraVenta == 1)
                                {
                                    <span class="badge bg-info text-dark mb-2 d-block">En Proceso</span>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <form asp-action="FinalizarCompraVenta" method="post" class="d-inline">
                                            <input type="hidden" name="idCompraVenta" value="@compraVenta.IdCompraVenta" />
                                            <button type="submit" class="btn btn-outline-success" title="Finalizar Venta">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                        <form asp-action="RechazarCompraVenta" method="post" class="d-inline">
                                            <input type="hidden" name="idCompraVenta" value="@compraVenta.IdCompraVenta" />
                                            <button type="submit" class="btn btn-outline-danger" title="Rechazar Venta">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else if (compraVenta.EstadoCompraVenta == 3)
                                {
                                    <span class="badge bg-primary">Finalizada</span>
                                }
                                else if (compraVenta.EstadoCompraVenta == 2)
                                {
                                    <span class="badge bg-danger">Rechazada</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>