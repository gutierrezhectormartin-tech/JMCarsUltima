@model List<JMCarsWeb.DTOs.SolicitudEscribanoDTO>
@{
    ViewData["Title"] = "Solicitudes Recibidas";
    var compraVentaPorSolicitud = ViewBag.CompraVentaPorSolicitud as Dictionary<int, JMCarsWeb.DTOs.CompraVentaDTO>;
}
<div class="container mt-4">
    
        <div class="mb-4">
            <h2 class="mb-1">Solicitudes Recibidas</h2>
            <p class="text-muted">Solicitudes de compraventa asignadas</p>
        </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card card-body p-5 text-center">
            <i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i>
            <h5 class="mt-3">Todavía no recibiste solicitudes.</h5>
            <p class="text-muted mb-0">Cuando un cliente te seleccione, tendras su solicitud aqui</p>
        </div>
    }
    else
    {
        <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Vehículo</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th class="text-center">Solicitud</th>
                        <th class="text-center">Compraventa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var solicitud = item.Solicitud;
                        var vehiculo = solicitud?.Vehiculo;

                        string textoEstado;
                        string claseEstado;

                        switch (solicitud?.EstadoSolicitud)
                        {
                            case 1:
                                textoEstado = "Pendiente";
                                claseEstado = "bg-warning text-dark";
                                break;
                            case 2:
                                textoEstado = "Aceptada";
                                claseEstado = "bg-success";
                                break;
                            case 3:
                                textoEstado = "Rechazada";
                                claseEstado = "bg-danger";
                                break;
                            case 4:
                                textoEstado = "Finalizada";
                                claseEstado = "bg-primary";
                                break;
                            default:
                                textoEstado = "Desconocido";
                                claseEstado = "bg-secondary";
                                break;
                        }

                        JMCarsWeb.DTOs.CompraVentaDTO compraVenta = compraVentaPorSolicitud != null && compraVentaPorSolicitud.ContainsKey(solicitud.IdSolicitud)
                            ? compraVentaPorSolicitud[solicitud.IdSolicitud]
                            : null;

                        <tr>
                            <td>
                                <div class="fw-bold" style="color: var(--jm-azul)">@vehiculo?.Modelo?.Marca?.NombreMarca @vehiculo?.Modelo?.Modelo @vehiculo?.Anio</div>
                                <div class="text-muted small">Vendedor: @vehiculo?.Vendedor?.NombreCompleto</div>
                            </td>
                            <td>
                                <div class="fw-bold">@solicitud?.Cliente?.NombreCompleto</div>
                                <div class="text-muted small">@solicitud?.Cliente?.Email</div>
                                @if(solicitud?.EstadoSolicitud == 2)
                                {
                                    <div class="small"><i class="bi bi-telephone me-1"></i>@solicitud?.Cliente?.Telefono</div>
                                }
                            </td>
                            <td class="text-muted">@solicitud?.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>

                            <!-- Columna Solicitud -->
                            <td class="text-center">
                                <span class="badge @claseEstado">@textoEstado</span>
                                @if (solicitud?.EstadoSolicitud == 1)
                                {
                                    <div class="d-flex justify-content-center gap-1 mt-2">
                                        <form asp-action="Aceptar" method="post" data-confirmar="¿Aceptar esta solicitud? Esto dejara el vehiculo En Tramite">
                                            <input type="hidden" name="idSolicitud" value="@solicitud.IdSolicitud" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Aceptar Solicitud">
                                                <i class="bi bi-check-circle"></i> Aceptar
                                            </button>
                                        </form>
                                        <form asp-action="Rechazar" method="post" data-confirmar="¿Rechazar esta Solicitud?">
                                            <input type="hidden" name="idSolicitud" value="@solicitud.IdSolicitud" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Rechazar Solicitud">
                                                <i class="bi bi-x-circle"></i> Rechazar
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>

                            <!-- Columna Compraventa -->
                            <td class="text-center">
                                @if (compraVenta == null)
                                {
                                    <span class="text-muted small">—</span>
                                }
                                else if (compraVenta.EstadoCompraVenta == 1)
                                {
                                    <span class="badge bg-info text-dark">En Proceso</span>
                                    <div class="d-flex justify-content-center gap-1 mt-2">
                                        <form asp-action="FinalizarCompraVenta" method="post" data-confirmar="Finalizar la compraventa? El vehiculo pasara a Vendido">
                                            <input type="hidden" name="idCompraVenta" value="@compraVenta.IdCompraVenta" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Finalizar Venta">
                                                <i class="bi bi-check-circle"></i> Finalizar
                                            </button>
                                        </form>
                                        <form asp-action="RechazarCompraVenta" method="post" data-confirmar="Rechazar la compraventa? El vehiculo volvera a estar publicado">
                                            <input type="hidden" name="idCompraVenta" value="@compraVenta.IdCompraVenta" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Rechazar Venta">
                                                <i class="bi bi-x-circle"></i> Rechazar
                                            </button>
                                        </form>
                                    </div>
                                }
                                else if (compraVenta.EstadoCompraVenta == 3)
                                {
                                    <span class="badge bg-primary">Finalizada</span>
                                }
                                else if (compraVenta.EstadoCompraVenta == 2)
                                {
                                    <span class="badge bg-danger">Rechazada</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
     </div>
    }
</div>
<div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow overflow-hidden">
            <div class="modal-header" style="background-color: var(--jm-azul); color: #fff;">
                <h5 class="modal-title"><i class="bi bi-question-circle me-2"></i>Confirma la accion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalConfirmarTexto"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnModalConfirmar">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script>
        
        var modalConfirmar = new bootstrap.Modal(document.getElementById('modalConfirmar'));
        var formPendiente = null;

        //aca paro los formularios, para pedirle una confirmacion al cliente o escribano o quien sea
        document.querySelectorAll('form[data-confirmar]').forEach(function (form) {
            form.addEventListener('submit', function (e){
                e.preventDefault();
                formPendiente = form;
                document.getElementById('modalConfirmarTexto').textContent = form.dataset.confirmar;
                modalConfirmar.show();
            });
        }); 

        //aca envio el formulario si le dan boton confirmar, y lo desabilito para que no le den dos veces
        document.getElementById('btnModalConfirmar').addEventListener('click', function(){
            this.disabled = true;
            if(formPendiente)
            {
                formPendiente.submit();
            }
        });
    </script>
}