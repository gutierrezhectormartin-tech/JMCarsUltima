@model List<JMCarsWeb.DTOs.VehiculoDTO>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<h1>Vehículos publicados</h1>

<form method="get" class="d-flex align-items-center gap-2 my-3">

    <input type="text"
           name="marca"
           placeholder="Buscar por marca"
           value="@Context.Request.Query["marca"]" 
           class="form-control"
    />

    <button type="submit" class="btn btn-primary">
        Buscar
    </button>

    <a href="/" class="btn btn-outline-dark" role="button">
        ← Volver
    </a>

</form>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Año</th>
            <th>Caja De Cambios</th>
            <th>Motorizacion</th>
            <th>Kilometraje</th>
            <th>Descripcion</th>
            <th>Precio</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var v in Model)
        {
            <tr>
                <td>@v.IdVehiculo</td>
                <td>@v.Modelo.Marca.NombreMarca</td>
                <td>@v.Modelo.Modelo</td>
                <td>@v.Anio</td>
                <td>@v.CajaCambios</td>
                <td>@v.Motorizacion</td>
                <td>@v.Km.ToString("N0")</td>
                <td>@v.Descripcion</td>
                <td>@v.Precio.ToString("C")</td>
                <td class="text-center">
                    <a asp-controller="Vehiculo" asp-action="Detalle" asp-route-id="@v.IdVehiculo" class="btn btn-outline-info btn-sm" title="Ver Detalle">
                        <i class="bi bi-eye"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>