@model JMCarsWeb.ViewModels.HomeViewModel

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}
@if(TempData["Advertencia"] != null)
{
    <div class="modal fade" id="modalAdvertencia" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i>Advertencia de sistema</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <ul class="mb-0">
                        @foreach (string aviso in TempData["Advertencia"]!.ToString()!.Split('|'))
                        {
                            <li>@aviso</li>
                        }
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Entendido</button>
                </div>
            </div>
        </div>

    </div>
}
@{
    var marcas = Model.Filtros.Modelos.Where(m => m.Marca != null)
        .Select(m => new { Id = m.Marca.IdMarca, Nombre = m.Marca.NombreMarca })
        .Distinct().OrderBy(x => x.Nombre).ToList();

    var modelos = Model.Filtros.Modelos.Where(m => m.Marca != null)
        .Select(m => new { idMarca = m.Marca.IdMarca, idModelo = m.IdModelo, Nombre = m.Modelo })
        .OrderBy(x => x.Nombre).ToList();
}
<section class="hero">
    <h1>Encontrá tu próximo auto</h1>
    <p class="mb-0">Cerca de vos. Seguro para todos. Publicaciones revisadas y cierre de la compraventa con escribano.</p>

    
</section>

@{
    JMCarsWeb.DTOs.EstadisticasDTO? conteos = ViewBag.Conteos as JMCarsWeb.DTOs.EstadisticasDTO;
}
@if(conteos != null)
{
    <div class="card mb-4">
        <div class="row g-0">
            <div class="col-6 numero-item">
                <div class="numero">@conteos.CantAprobadas</div>
                <div class="etiqueta">Vehiculos Publicados</div>
            </div>
            <div class="col-6 numero-item">
                <div class="numero">@conteos.CantVendidas</div>
                <div class="etiqueta">Vehiculos VEndidos</div>
            </div>
        </div>

    </div>
}
@{
    List<JMCarsWeb.DTOs.VehiculoDTO> destacados = ViewBag.Destacados as List<JMCarsWeb.DTOs.VehiculoDTO>
        ?? new List<JMCarsWeb.DTOs.VehiculoDTO>();
    int porSlide = 3;
    int cantidadSlides = (int)Math.Ceiling(destacados.Count / (double)porSlide);
}

@if (destacados.Any())
{

    <h2 class="titulo-seccion">Destacados <small>Los últimos vehículos publicados</small></h2>


    <div id="carruselDestacados" class="carousel slide carrusel-tarjetas mb-5" data-bs-ride="carousel" data-bs-interval="6000">
        <div class="carousel-inner px-1 pt-2 pb-3">
            @for (int s = 0; s < cantidadSlides; s++)
            {
                <div class="carousel-item @(s == 0 ? "active" : "")">
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
                        @foreach (var d in destacados.Skip(s * porSlide).Take(porSlide))
                        {
                            string foto = d.Fotografia.First().Replace("\\", "/");

                            <div class="col">
                                <div class="card vehiculo-card vehiculo-card-destacada h-100">
                                    <span class="etiqueta-destacado">Destacado</span>
                                    <img class="vehiculo-foto" src="/@foto" alt="@d.Modelo.Marca.NombreMarca @d.Modelo.Modelo" />
                                    <div class="card-body pb-2">
                                        <h3 class="h6 mb-1">@d.Modelo.Marca.NombreMarca @d.Modelo.Modelo</h3>
                                        <div class="vehiculo-datos mb-2">@d.Anio · @d.Km.ToString("N0") km · @d.CajaCambios</div>
                                        <div class="vehiculo-precio">@d.Precio.ToString("C")</div>
                                    </div>
                                    <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                                        <a asp-controller="Vehiculo" asp-action="Detalle" asp-route-id="@d.IdVehiculo" asp-route-origen="home" class="btn btn-outline-primary btn-sm w-100">Ver detalle</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
         @if (cantidadSlides > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#carruselDestacados" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anteriores</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carruselDestacados" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Siguientes</span>
            </button>
        }
    </div>
}

<h2 class="titulo-seccion">Todos los vehículos <small>Filtrá por marca, modelo o año</small></h2>

<form id="formFiltros" method="get" class="card card-body mb-4">
    <div class="row g-2">
        <div class="col-12 col-md-3">
            <select name="marca" class="form-select">
                <option value="">Todas las marcas</option>
                @foreach (var marca in marcas)
                {
                    <option value="@marca.Id" selected="@(Model.Marca == marca.Id)">@marca.Nombre</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-3">
            <select name="modelo" class="form-select">
                <option value="">Todos los modelos</option>
                @foreach (var modelo in modelos)
                {
                    <option value="@modelo.idModelo" data-marca="@modelo.idMarca" selected="@(Model.Modelo == modelo.idModelo)">@modelo.Nombre</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select name="anio" class="form-select">
                <option value="">Todos los años</option>
                @foreach (var anio in Model.Filtros.Anios)
                {
                    <option value="@anio" selected="@(Model.Anio == anio)">@anio</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select name="ordenPrecio" class="form-select">
                <option value="">Ordenar por precio</option>
                <option value="asc" selected="@(Model.OrdenPrecio == "asc")">Menor a mayor</option>
                <option value="desc" selected="@(Model.OrdenPrecio == "desc")">Mayor a menor</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <a href="/" class="btn btn-outline-primary w-100" role="button">Limpiar</a>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="contador-vehiculos text-muted small" data-total="@Model.Vehiculos.Total">Mostrando @Model.Vehiculos.Items.Count de @Model.Vehiculos.Total vehículos</span>
</div>

@if (!Model.Vehiculos.Items.Any())
{
    <div class="card card-body p-5 text-center mb-4">
        <i class="bi bi-car-front text-muted" style="font-size: 2.5rem"></i>
        <h5 class="mt-3">No encontramos vehículos con esos filtros</h5>
        <p class="text-muted mb-0">Probá con otra combinación o limpiá los filtros</p>
    </div>
}
else
{
    <div id="vistaTarjetas" class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 row-cols-xl-5 g-3 mb-4">
        <partial name="_TarjetasVehiculos" model="Model.Vehiculos.Items" />
    </div>
    <div class="text-center mb-5">
        @if (Model.Vehiculos.HayMas)
        {
            <button type="button" id="btnCargarMas" class="btn btn-outline-primary" data-pagina="2">Cargar más</button>
        }
        <div class="contador-vehiculos text-muted small mt-2" data-total="@Model.Vehiculos.Total">Mostrando @Model.Vehiculos.Items.Count de @Model.Vehiculos.Total vehículos</div>
    </div>
}
<section class="my-5">
    <h2 class="titulo-seccion">Como funciona <small>Compra o vende en tres pasos</small></h2>
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <div class="paso-numero">1</div>
                    <h3 class="h5">Publica o busca</h3>
                    <p class="text-muted mb-0">Registrate, publica tu vehiculo o encuentra el que quieres</p>
                </div>
            </div>
       </div>
       <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <div class="paso-numero">2</div>
                    <h3 class="h5">Habla con el vendedor/comprador</h3>
                    <p class="text-muted mb-0">Conectate directamente desde nuestra web/app</p>
                </div>
            </div>
        </div>
       <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body p-4">
                    <div class="paso-numero">3</div>
                    <h3 class="h5">Cerra con confianza</h3>
                    <p class="text-muted mb-0">Selecciona un escribano con nosotros y tene respaldo legal</p>
                </div>
            </div>
        </div>
            </div>

    </div>
</section>
<script>
    const formFiltros = document.getElementById('formFiltros');
    const selMarca = formFiltros.querySelector('select[name="marca"]');
    const selModelo = formFiltros.querySelector('select[name="modelo"]');

    // Muestra solo los modelos de la marca elegida
    function filtrarModelosPorMarca() {
        const marcaSeleccionada = selMarca.value;
        selModelo.querySelectorAll('option').forEach(function (option) {
            if (!option.value) return;
            option.style.display = !marcaSeleccionada || option.dataset.marca === marcaSeleccionada ? '' : 'none';
        });
    }

    filtrarModelosPorMarca();

    // Cada vez que se cambia un filtro, se pide al servidor la lista filtrada
    formFiltros.querySelectorAll('select').forEach(function (sel) {
        sel.addEventListener('change', function () {
            if (sel === selMarca) {
                selModelo.value = '';
            }
            formFiltros.submit();
        });
    });

    // Botón "Cargar más": pide la página siguiente y la agrega al final
    const btnCargarMas = document.getElementById('btnCargarMas');
    if (btnCargarMas) {
        btnCargarMas.addEventListener('click', async function () {
            const pagina = parseInt(btnCargarMas.dataset.pagina);
            const parametros = new URLSearchParams(window.location.search);
            parametros.set('pagina', pagina);

            btnCargarMas.disabled = true;
            btnCargarMas.textContent = 'Cargando...';

            try {
                const respuesta = await fetch('@Url.Action("CargarMas", "Home")?' + parametros.toString());
                if (!respuesta.ok) {
                    throw new Error();
                }
                const html = await respuesta.text();
                const contenedor = document.getElementById('vistaTarjetas');
                contenedor.insertAdjacentHTML('beforeend', html);

                document.querySelectorAll('.contador-vehiculos').forEach(function (c) {
                    c.textContent = 'Mostrando ' + contenedor.children.length + ' de ' + c.dataset.total + ' vehículos';
                });

                if (respuesta.headers.get('X-Hay-Mas') === 'true') {
                    btnCargarMas.dataset.pagina = pagina + 1;
                    btnCargarMas.disabled = false;
                    btnCargarMas.textContent = 'Cargar más';
                } else {
                    btnCargarMas.remove();
                }
            } catch (e) {
                btnCargarMas.disabled = false;
                btnCargarMas.textContent = 'No se pudo cargar. Reintentar';
            }
        });
    }
</script>
@if(TempData["Advertencia"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var modal = new bootstrap.Modal(document.getElementById('modalAdvertencia'));
            modal.show();
        });
    </script>
}
