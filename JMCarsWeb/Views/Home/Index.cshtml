@model List<JMCarsWeb.DTOs.VehiculoDTO>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@{
    var marcas = Model.Where(v => v.Modelo?.Marca != null).Select(v => new { Id = v.Modelo.Marca.IdMarca, Nombre = v.Modelo.Marca.NombreMarca })
            .Distinct().OrderBy(x => x.Nombre).ToList();
}

@{
    var modelos = Model.Where(v => v.Modelo != null && v.Modelo.Marca != null).Select(v => new
    {
        idMarca = v.Modelo.Marca.IdMarca,
        idModelo = v.Modelo.IdModelo,
        Nombre = v.Modelo.Modelo
    }).Distinct().OrderBy(x => x.Nombre).ToList();
}

<h1>Vehículos publicados</h1>

<form method="get" class="d-flex align-items-center gap-2 my-3">

    <select name="marca" class="form-select">
        <option value="">Lista de Marcas</option>

        @foreach (var marca in marcas)
            {
                <option value="@marca.Id">
                    @marca.Nombre
                </option>
            }
    </select>
    <select name="modelo" class="form-select">
        <option value="">Lista de Modelos</option>

        @foreach (var modelo in modelos)
            {
                <option value="@modelo.idModelo" data-marca="@modelo.idMarca">
                    @modelo.Nombre
                </option>
            }
    </select> 
    <select name="anio" class="form-select">
        <option value="">Todos los años</option>
        @foreach(var anio in Model.Select(v => v.Anio).Distinct().OrderBy(a => a))
            {
                <option value="@anio">@anio</option>
            }
        </select>
        <select name="ordenPrecio" class="form-select">
            <option value="">Ordenar por Precio</option>
            <option value="asc">Menor a Mayor</option>
            <option value="desc">Mayor a Menor</option>
        </select>
    <a href="/" class="btn btn-outline-dark" role="button">
        Limpiar
    </a>

</form>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Marca</th>
            <th>Modelo</th>
            <th>Año</th>
            <th>Caja De Cambios</th>
            <th>Motorizacion</th>
            <th>Kilometraje</th>
            <th>Descripcion</th>
            <th>Precio</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var v in Model)
        {
            <tr data-marca="@v.Modelo.Marca.IdMarca" data-modelo="@v.Modelo.IdModelo" data-anio="@v.Anio">
                <td>@v.IdVehiculo</td>
                <td>@v.Modelo.Marca.NombreMarca</td>
                <td>@v.Modelo.Modelo</td>
                <td>@v.Anio</td>
                <td>@v.CajaCambios</td>
                <td>@v.Motorizacion</td>
                <td>@v.Km.ToString("N0")</td>
                <td>@v.Descripcion</td>
                <td>@v.Precio.ToString("C")</td>
                <td class="text-center">
                    <a asp-controller="Vehiculo" asp-action="Detalle" asp-route-id="@v.IdVehiculo" asp-route-origen="home" class="btn btn-outline-info btn-sm" title="Ver Detalle">
                        <i class="bi bi-eye"></i>
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    // Guardar orden original de años al cargar la página
    const ddlAnio = document.querySelector('select[name="anio"]');
    const ordenOriginalAnios = Array.from(ddlAnio.querySelectorAll('option[value]')).map(o => o.value);

    function aplicarFiltros() {
        const marcaSeleccionada = document.querySelector('select[name="marca"]').value;
        const modeloSeleccionado = document.querySelector('select[name="modelo"]').value;
        const anioSeleccionado = document.querySelector('select[name="anio"]').value;

        // Filtrar filas
        document.querySelectorAll('tbody tr').forEach(function (fila) {
            const coincideMarca = !marcaSeleccionada || fila.dataset.marca === marcaSeleccionada;
            const coincideModelo = !modeloSeleccionado || fila.dataset.modelo === modeloSeleccionado;
            const coincideAnio = !anioSeleccionado || fila.dataset.anio === anioSeleccionado;
            fila.style.display = coincideMarca && coincideModelo && coincideAnio ? '' : 'none';
        });

        // Actualizar opciones de año según marca y modelo seleccionados
        const aniosVisibles = new Set();
        document.querySelectorAll('tbody tr').forEach(function (fila) {
            const coincideMarca = !marcaSeleccionada || fila.dataset.marca === marcaSeleccionada;
            const coincideModelo = !modeloSeleccionado || fila.dataset.modelo === modeloSeleccionado;
            if (coincideMarca && coincideModelo) aniosVisibles.add(fila.dataset.anio);
        });

        document.querySelectorAll('select[name="anio"] option').forEach(function (option) {
            if (!option.value) return;
            option.style.display = aniosVisibles.has(option.value) ? '' : 'none';
        });

        // Restaurar orden original de años
        ordenOriginalAnios.forEach(function(anio) {
            const option = ddlAnio.querySelector(`option[value="${anio}"]`);
            if (option) ddlAnio.appendChild(option);
        });
    }

    document.querySelector('select[name="marca"]').addEventListener('change', function () {
        const marcaSeleccionada = this.value;
        const ddlModelo = document.querySelector('select[name="modelo"]');
        ddlModelo.value = '';
        ddlModelo.querySelectorAll('option').forEach(function (option) {
            if (!option.value) return;
            option.style.display = !marcaSeleccionada || option.dataset.marca === marcaSeleccionada ? '' : 'none';
        });
        aplicarFiltros();
    });

    document.querySelector('select[name="modelo"]').addEventListener('change', aplicarFiltros);
    document.querySelector('select[name="anio"]').addEventListener('change', aplicarFiltros);

    document.querySelector('select[name="ordenPrecio"]').addEventListener('change', function () {
        const orden = this.value;
        if (!orden) return;
        const tbody = document.querySelector('tbody');
        const filas = Array.from(tbody.querySelectorAll('tr'));
        filas.sort(function (a, b) {
            const precioA = parseFloat(a.cells[8].textContent.replace(/[^0-9.]/g, ''));
            const precioB = parseFloat(b.cells[8].textContent.replace(/[^0-9.]/g, ''));
            return orden === 'asc' ? precioA - precioB : precioB - precioA;
        });
        filas.forEach(function (fila) { tbody.appendChild(fila); });
    });
</script>