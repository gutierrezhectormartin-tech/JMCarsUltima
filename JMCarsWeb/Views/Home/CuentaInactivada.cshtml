@{
    ViewData["Title"] = "Cuenta inactivada";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="card card-body p-4 text-center">
            <i class="bi bi-person-slash" style="font-size: 3rem; color: var(--jm-azul);"></i>
            <h2 class="mt-2 mb-2">Tu cuenta fue inactivada</h2>
            <p class="text-muted">Cerraste tu cuenta en JMCars. Si querés volver a usar el sistema, comunicate con un administrador para que la reactive.</p>
            <div class="d-grid">
                @Html.ActionLink("Volver al inicio", "Index", "Home", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>
