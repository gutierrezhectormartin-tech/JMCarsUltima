@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList

@{
    Func<int, string> enlace = page =>
            {
                var valores = new RouteValueDictionary();
                foreach (var par in Context.Request.Query)
                {
                    valores[par.Key] = par.Value.ToString();
                }
                valores["pagina"] = page;
                return Url.Action(ViewContext.RouteData.Values["action"]?.ToString(), ViewContext.RouteData.Values["controller"]?.ToString(), valores);
            };
}

@if (Model.PageCount > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted small">
            Mostrando @Model.FirstItemOnPage a @Model.LastItemOnPage de @Model.TotalItemCount
        </div>
        @Html.PagedListPager(Model, enlace, new PagedListRenderOptions
            {
                LiElementClasses = new string[] {"page-item"},
                PageClasses = new string[] {"page-link"}
            })
    </div>
}