@model JMCarsWeb.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-7 col-lg-5 col-xl-4">
               
        @if(TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if(TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-success">@ViewBag.Mensaje</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <div class="card card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-person-circle" style="font-size: 3rem; color: var(--jm-azul);"></i>
                <h2 class="mt-2 mb-1">Iniciar Sesion</h2>
                <div class="text-muted small">Ingresa tu correo y contraseña</div>
            </div>
        @using (Html.BeginForm("Login", "Login", FormMethod.Post))
        {
            <div class="mb-3">
                @Html.LabelFor(m => m.Email, "Email", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", required = "required" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Contrasena, "Contraseña", new { @class = "form-label" })
                @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control", required = "required" })
            </div>
            <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        }

        <p class="text-center mt-3">
            @Html.ActionLink("¿Olvidaste tu contraseña?", "RecuperarContrasena", "Usuario")
        </p>

        <hr class="my-4"/>

        <div class="text-center">
            <div class="text-muted small mb-2">¿No tenes cuenta?</div>
            <div class="d-grid gap-2">
                @Html.ActionLink("Registrate como Cliente", "Registro", "Cliente", null, new {@class="btn btn-outline-primary"})
                @Html.ActionLink("Registrate como Escribano", "Registro", "Escribano", null, new {@class="btn btn-outline-primary"})
            </div>
        </div>
    </div>
</div>
</div>