@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-7 col-lg5 col-xl-4">

        @if(TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if(TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }

        @if(ViewBag.Mensaje != null)
        {
            <div class="alert alert-success">@ViewBag.Mensaje</div>
        }
        @if(ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        
        <div class="card card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock" style="font-size: 3rem; color: var(--jm-azul);"></i>
                <h2 class="mt-2 mb-1">Reestablecer Contraseña</h2>
                <div class="text-muted small">Elegi tu nueva contraseña</div>
            </div>
        @using (Html.BeginForm("ResetearContrasena", "Usuario", FormMethod.Post))
        {
            <input type="hidden" name="ptoken" value="@ViewBag.Token"/>

            <div class="mb-3">
                <label class="form-label">Nueva Contraseña</label>
                <input type="password" name="pNuevaContrasena" class="form-control" required minlength="3" />
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-check-circle"></i>Restablecer Contraseña

            </button>
        }
    </div>
</div>
</div>