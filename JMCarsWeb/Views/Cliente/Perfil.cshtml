@model JMCarsWeb.DTOs.ClienteDTO
@{
    ViewData["Title"] = "Mi perfil";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="text-center mb-4">
                <i class="bi bi-person-circle" style="font-size: 3rem; color: var(--jm-azul);"></i>
                <h2 class="mt-2 mb-1">Mi Perfil</h2>
                <div class="text-muted small">Datos y Seguridad de tu cuenta</div>
        </div>

        @if(TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if(TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-success">@ViewBag.Mensaje</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <div class="card card-body p-4 mb-4">
            <h5 class="mb-3">Datos Personales</h5>
        @using (Html.BeginForm("Perfil", "Cliente", FormMethod.Post))
        {
            <div class="mb-3">
                @Html.LabelFor(m => m.NombreCompleto, "Nombre completo", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NombreCompleto, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Telefono, "Teléfono", new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Email, "Email", new { @class = "form-label" })
                <input type = "text" class = "form-control" value = "@Model.Email" disabled  = "disabled"/>
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Cedula, "Cédula", new { @class = "form-label" })
               <input type = "text" class = "form-control" value="@Model.Cedula" disabled = "disabled"/>
            </div>
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
        }
        </div>
        <div class="card card-body p-4 mb-4">
        <h5 class="mb-3">Cambiar Contraseña</h5>
        @using (Html.BeginForm("CambiarContrasena", "Usuario", FormMethod.Post))
        {
            <div class="mb-3">
                <label class="form-label">Contraseña Actual</label>
                <input type="password" name="contrasenaActual" class="form-control" autocomplete="current-password" required/>
            </div>
            <div>
                <label class="form-label">Contraseña Nueva</label>
                <input type="password" name="contrasenaNueva" class="form-control" autocomplete="new-password" required minlength="3" />
            </div>
            <div>
                <label class="form-label">Repetir Contraseña Nueva</label>
                <input type="password" name="repetirContrasenaNueva" class="form-control" autocomplete="new-password" required minlength="3"/>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Cambiar Contraseña</button>
        }
        </div>
        
        <div class="card card-body p-4 mb-4 border border-danger-subtle">
        <h5 class="mb-2 text-danger">Inactivar cuenta</h5>
        <p class="text-muted">Si inactivás tu cuenta vas a quedar fuera del sistema. Después, solo un administrador puede reactivarla.</p>
        @using (Html.BeginForm("Inactivar", "Cliente", FormMethod.Post))
        {
            <button type="submit" class="btn btn-danger w-100">Inactivar mi cuenta</button>
        }
       </div>
    </div>
</div>
