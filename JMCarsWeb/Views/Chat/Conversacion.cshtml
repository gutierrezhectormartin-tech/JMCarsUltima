@model List<JMCarsWeb.DTOs.MensajeDTO>

@{
    ViewData["Title"] = "Mensajes";
    int idChat = (int)ViewBag.IdChat;
    int idUsuario = (int)ViewBag.IdUsuario;
    int? idRolActual = Context.Session.GetInt32("IdRol");
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-lg-9 col-xl-8">
        
        <div class="mb-3">
            <a asp-controller="Chat" asp-action="Historial" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver a mis conversaciones
            </a>
        </div>
        <div class="text-center mb-4">
            <i class="bi bi-chat-dots" style="font-size: 3rem; color: var(--jm-azul);"></i>
            <h2 class="mt-2 mb-1">Conversacion</h2>
            <div class="text-muted small">Chatea con el vendedor</div>
        </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card mb-3">
        <div class="card-body" style="height: 400px; overflow-y: auto" id="contenedorMensajes">
            @if(Model == null || !Model.Any())
            {
                <p class="text-muted text-center mt-5">Aun no tienes mensajes en este chat</p>
            }
            else
            {
                @foreach (var mensaje in Model)
                {
                    @if(mensaje.UsuarioEmisor?.IdUsuario == idUsuario)
                    {
                        <div class="d-flex justify-content-end mb-2">
                            <div class="bg-primary text-white px-3 py-2" style="max-width: 70%; border-radius: 14px 14px 4px 14px;">
                                <div class="small fw-bold">Vos</div>
                                <div>@mensaje.Contenido</div>
                                <div class="small text-white-50 text-end">@mensaje.FechaHora.ToString("HH:mm")</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-start mb-2">
                            <div class="px-3 py-2" style="max-width: 70%; background-color: #e9edf5; border-radius: 14px 14px 14px 4px;">
                                <div class="small fw-bold" style="color: var(--jm-azul);">@mensaje.UsuarioEmisor?.NombreCompleto</div>
                                <div>@mensaje.Contenido</div>
                                <div class="small text-muted text-end">@mensaje.FechaHora.ToString("HH:mm")</div>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>

    @if(idRolActual == 3 && (int)ViewBag.IdVehiculo > 0)
    {
        <div class="mb-3 text-end">
            <a href="@Url.Action("Solicitar", "SolicitudNotarial", new {idVehiculo = ViewBag.IdVehiculo})" class="btn btn-outline-primary">
                <i class="bi bi-file-earmark-text"></i> Solicitar Escribamo
            </a>
        </div>
    }

    @using (Html.BeginForm("EnviarMensaje", "Chat", FormMethod.Post))
    {
        <input type="hidden" name="idVehiculo" value="@((int)ViewBag.IdVehiculo)" />
        <input type="hidden" name="idChat" value="@idChat"/>
        <div class="input-group">
            <input type="text" name="contenido" class="form-control" placeholder="Nuevo mensaje..." required/>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-send"></i> Enviar
            </button>

        </div>
    }
</div>

<script>

    //esto es el scroll automatico que hace que se lleve el chat al ultimo mensaje
    var contenedor = document.getElementById('contenedorMensajes');
    contenedor.scrollTop = contenedor.scrollHeight;

    //recargamos la pagina cada 10 segundos por las dudas que la otra parte del chat envie mensajess y nosotros tengamos la pagina abierta
    var campoMensaje = document.querySelector('input[name=contenido]');

    setInterval(function() { 
        if(!campoMensaje.value)
        {
            location.reload(); 
        }
    }, 10000);
</script>