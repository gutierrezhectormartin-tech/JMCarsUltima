@model List<JMCarsWeb.DTOs.ChatDTO>
@{
    ViewData["Title"] = "Historial de Chat";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>
                Historial de Conversaciones
            </h2>
            <p class="text-muted mb-0">Tus conversaciones</p>
        </div>
    </div>

    <hr />

    @if(TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if(TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if(Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Aun no tienes conversaciones
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var chat in Model)
            {
                <a href="@Url.Action("Conversacion", "Chat", new {idChat = chat.IdChat})" class="list-group-item list-group-item-action">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@chat.Vehiculo?.Modelo?.Marca?.NombreMarca @chat.Vehiculo?.Modelo?.Modelo @chat.Vehiculo?.Anio</strong>
                            <div class="text-muted small">Con: @chat.NombreOtroUsuario</div>
                            @if(!string.IsNullOrEmpty(chat.UltimoMensaje))
                            {
                                <div class="text-muted small">@chat.UltimoMensaje</div>
                            }
                        </div>
                        <div class="text-muted small">
                            @if(chat.FechaUltimoMensaje.HasValue)
                            {
                                @chat.FechaUltimoMensaje.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                        </div>
                    </div>

                </a>
            }

        </div>
    }
</div>