@model JMCarsWeb.ViewModels.ChatsViewModel
@{
    ViewData["Title"] = "Consultas del Vehiculo";
    int idVehiculo = (int)ViewBag.IdVehiculo;
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-lg-9 col-xl-8">
        
        <div class="mb-3">
            <a asp-controller="Vehiculo" asp-action="MisVehiculos" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver a mis Vehiculos
            </a>
        </div>

        <div class="text-center mb-4">
            <i class="bi bi-chat-left-text" style="font-size: 3rem; color: var(--jm-azul);" ></i>
            <h2 class="mt-2 mb-1">Consultas del Vehiculo</h2>
            <div class="text-muted small">Compradores interesados en tu vehiculo</div>
        </div>

    @if(TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if(TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-controller="Chat" asp-action="ConsultasVehiculo" method="get" class="row g-2 mb-3">
        <input type="hidden" name="idVehiculo" value="@idVehiculo"/>
        <div class="col-md-8">
            <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Interesado o parte del ultimo mensaje"/>
        </div>
        <div class="col-md-4 d-flex gap-1">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-controller="Chat" asp-action="ConsultasVehiculo" asp-route-idVehiculo="@idVehiculo" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="muted-text small mb-2">@Model.TotalFiltrados resultado(s)</div>

    @if(Model.Chats == null || !Model.Chats.Any())
    {
        <div class="card card-body p-5 text-center">
            <i class="bi bi-chat-square-text text-muted" style="font-size: 2.5rem;"></i>
            @if(!string.IsNullOrEmpty(Model.Buscar))
            {
                <h5 class="mt-3">No hay con ese texto</h5>
                <p class="text-muted mb-0">Proba con otra busqueda o limpia el filtro</p>
            }
            else
            {
                <h5 class="mt-3">Todavia no tienes consultas</h5>
                <p class="text-muted mb-0">Cuando te consulten esas conversaciones apareceran aqui</p>
            }

        </div>
    }
    else
    {
        <div class="d-grid gap-3">
            @foreach(var chat in Model.Chats)
            {
                <a href="@Url.Action("ConversacionesVendedor", "Chat", new {idChat = chat.IdChat, idVehiculo = idVehiculo})" class="card vehiculo-card text-decoration-none">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle"
                            style="width: 48px; height: 48px; background-color: #e9edf5; color: var(--jm-azul); font-size: 1.3rem;">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="flex-grow-1" style="min-width: 0;">
                            <div class="fw-bold" style="color: var(--jm-azul);">@chat.NombreOtroUsuario</div>
                            @if(!string.IsNullOrEmpty(chat.UltimoMensaje))
                            {
                                <div class="text-truncate small" style="color: #1f2937;">@chat.UltimoMensaje</div>
                            }
                        </div>
                        <div class="text-muted small text-end flex-shrink-0">
                            @if(chat.FechaUltimoMensaje.HasValue)
                            {
                                @chat.FechaUltimoMensaje.Value.ToString("dd/MM/yyyy HH:mm")
                            }

                        </div>
                    </div>
                </a>
            }
        </div>
        <partial name="_Paginador" model="Model.Chats"/>
    }

    </div>
</div>