@model List<JMCarsWeb.DTOs.VehiculoDTO>
@{
    ViewData["Title"] = "Buscar Vehiculos";
}

<div class="row justify-content-center m-5">
    <div class="col-md-10">
        <h2>Buscar Vehiculos Cercanos</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success">@TempData["Mensaje"]</div>
        }

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-success">@ViewBag.Mensaje</div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Buscar", "Vehiculo", FormMethod.Post))
        {
            <div class="mb-3">
                <label class="form-label">Tu Ubicacion</label>
                <input type="text" id="inputDireccion" class="form-control" placeholder="Ej. Avda Rivera 2869, Montevideo"/>
                <button type="button" id="btnBuscarDireccion" class="btn btn-secondary mt-2">Buscar en el Mapa</button>
            </div>
            
            <div id="mapaBusqueda" style="height: 400px;" class="mb-3"></div>
            <input type="hidden" id="inputLatCli" name="latCli" value="@ViewBag.LatCli" />
            <input type="hidden" id="inputLonCli" name="lonCli" value="@ViewBag.LonCli" />
            <input type="hidden" id="inputDireccionHidden" name="direccion" value="@ViewBag.Direccion" />

            <div class="mb-3">
                <label class="form-label">Radio de Busqueda</label>
                <input type="number" name="radioKM" class="form-control" value="@(ViewBag.RadioKM ?? 5)" min="1" max="100" />
            </div>
            <div id="filtros" style="display:none;">
    <div class="row mt-3">
        <div class="col-md-3 mb-3">
            <select class="form-select" id="filtroMarca">
                <option value="">Todas las marcas</option>
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <select class="form-select" id="filtroModelo">
                <option value="">Todos los modelos</option>
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <select class="form-select" id="filtroAnio">
                <option value="">Todos los años</option>
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <select class="form-select" id="filtroOrden">
                <option value="asc">Precio: menor a mayor</option>
                <option value="desc">Precio: mayor a menor</option>
            </select>
        </div>
    </div>
</div>


            <button type="submit" class="btn btn-primary">Buscar Vahiculos</button>
        }
    </div>
</div>
<script>

    delete L.Icon.Default.prototype._getIconUrl;
    L.Icon.Default.mergeOptions({
        iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
        iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
        shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
    });

    var latInicial = @(ViewBag.LatCli ?? "-34.9011");
    var lonInicial = @(ViewBag.LonCli ?? "-56.1645");
    var radioInicial = @(ViewBag.RadioKM ?? 5);

    var iconoRojo = new L.Icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
        shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41]
    });

    var mapa = L.map('mapaBusqueda').setView([latInicial, lonInicial], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {attribution: '&copy;OpenStreetMap constributiors'}).addTo(mapa);

    var marcadorUsuario = L.marker([latInicial, lonInicial], {draggable: true, icon: iconoRojo}).addTo(mapa);
    var direccionGuardada = '@ViewBag.Direccion';
    if (direccionGuardada) 
        {
            document.getElementById('inputDireccion').value = direccionGuardada;
        }
    var circulo = L.circle([latInicial, lonInicial], {radius: radioInicial * 1000, color: 'blue', fillOpacity: 0.1}).addTo(mapa);
</script>
<script>
    document.getElementById('btnBuscarDireccion').addEventListener('click', function (){
        var direccion = document.getElementById('inputDireccion').value;

        if(!direccion)
        {
            alert ('Por favor ingrese una direccion');
            return;
        }
        var url = 'https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(direccion);
        fetch(url).then(function(respuesta) {return respuesta.json();})
        .then(function(resultados) {
            if(resultados.length === 0)
            {
                alert('No se encontro la direccion');
                return;
            }

            var lat = parseFloat(resultados[0].lat);
            var lon = parseFloat(resultados[0].lon);

            actualizarUbicacion(lat, lon);
        });
    });
    function actualizarUbicacion(lat, lon)
        {
            mapa.setView([lat,lon], 14);
            marcadorUsuario.setLatLng([lat,lon]);
            circulo.setLatLng([lat,lon]);

            document.getElementById('inputLatCli').value = lat.toFixed(6);
            document.getElementById('inputLonCli').value = lon.toFixed(6);
            document.getElementById('inputDireccionHidden').value = document.getElementById('inputDireccion').value;
        }

</script>
<script>
    marcadorUsuario.on('dragend', function(evento){
        
        var posicion = evento.target.getLatLng();

        actualizarUbicacion(posicion.lat, posicion.lng);

        fetch('https://nominatim.openstreetmap.org/reverse?format=json&lat=' + posicion.lat + '&lon=' + posicion.lng)
        .then(function (respuesta) {return respuesta.json(); })
        .then(function (resultado) 
        {
            if(resultado.display_name)
            {
                document.getElementById('inputDireccion').value = resultado.display_name;
                document.getElementById('inputDireccionHidden').value = resultado.display_name;
            }
        });
    });

    document.querySelector('input[name="radioKM"]').addEventListener('input', function() 
    {
        var radioKM = parseFloat(this.value);
        if(!isNaN(radioKM) && radioKM > 0)
        {
            circulo.setRadius(radioKM * 1000); //lo transformamos en metros, porque es lo que usa leaflet
        }
    });
</script>

@if(Model != null && Model.Any())
{
    <script>
        document.getElementById('filtros').style.display = 'block';
        var vehiculos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(v => new
            {
                id = v.IdVehiculo,
                lat = v.Latitud,
                lon = v.Longitud,
                marca = v.Modelo.Marca.NombreMarca,
                idMarca = v.Modelo.Marca.IdMarca,
                modelo = v.Modelo.Modelo,
                idModelo = v.Modelo.IdModelo,
                anio = v.Anio,
                precio = v.Precio,
                km = v.Km
            }))
        );

        // Poblar filtros con valores únicos
        var marcasUnicas = [...new Map(vehiculos.map(v => [v.idMarca, v.marca])).entries()];
        marcasUnicas.sort((a, b) => a[1].localeCompare(b[1]));
        marcasUnicas.forEach(function([id, nombre]) {
            document.getElementById('filtroMarca').innerHTML += `<option value="${id}">${nombre}</option>`;
        });

        var modelosUnicos = [...new Map(vehiculos.map(v => [v.idModelo, {nombre: v.modelo, idMarca: v.idMarca}])).entries()];
        modelosUnicos.sort((a, b) => a[1].nombre.localeCompare(b[1].nombre));
        modelosUnicos.forEach(function([id, data]) {
            document.getElementById('filtroModelo').innerHTML += `<option value="${id}" data-marca="${data.idMarca}">${data.nombre}</option>`;
        });

        var aniosUnicos = [...new Set(vehiculos.map(v => v.anio))].sort((a, b) => b - a);
        aniosUnicos.forEach(function(anio) {
            document.getElementById('filtroAnio').innerHTML += `<option value="${anio}">${anio}</option>`;
        });

        // Crear marcadores
        var marcadores = [];
        vehiculos.forEach(function (v) {
            if(v.lat && v.lon) {
                var marcador = L.marker([v.lat, v.lon]).addTo(mapa);
                marcador.bindPopup('<b>' + v.marca + ' ' + v.modelo + '</b><br>' + 
                    'Año: ' + v.anio + '<br>' +
                    'Precio: $' + v.precio + '<br>' + 
                    'Km: ' + v.km + '<br><br>' + 
                    '<a href="/vehiculo/Detalle?id=' + v.id + '&origen=buscar">Ver Vehiculo</a>');
                marcadores.push({ marcador, data: v });
            }
        });

        // Filtrar marcadores
        function aplicarFiltros() {
            var marcaSeleccionada = document.getElementById('filtroMarca').value;
            var modeloSeleccionado = document.getElementById('filtroModelo').value;
            var anioSeleccionado = document.getElementById('filtroAnio').value;

            marcadores.forEach(function(item) {
                var visible = true;
                if (marcaSeleccionada && item.data.idMarca != marcaSeleccionada) visible = false;
                if (modeloSeleccionado && item.data.idModelo != modeloSeleccionado) visible = false;
                if (anioSeleccionado && item.data.anio != anioSeleccionado) visible = false;

                if (visible) item.marcador.addTo(mapa);
                else mapa.removeLayer(item.marcador);
            });
        }

        // Filtro de marca — oculta modelos de otras marcas
        document.getElementById('filtroMarca').addEventListener('change', function() {
            var marcaSeleccionada = this.value;
            document.getElementById('filtroModelo').value = '';
            document.querySelectorAll('#filtroModelo option').forEach(function(opt) {
                if (!opt.value) return;
                opt.style.display = !marcaSeleccionada || opt.dataset.marca === marcaSeleccionada ? '' : 'none';
            });
            aplicarFiltros();
        });

        document.getElementById('filtroModelo').addEventListener('change', aplicarFiltros);
        document.getElementById('filtroAnio').addEventListener('change', aplicarFiltros);
    </script>
}