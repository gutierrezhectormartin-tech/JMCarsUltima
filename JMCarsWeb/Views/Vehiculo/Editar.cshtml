@model JMCarsWeb.DTOs.VehiculoDTO
@{
    ViewData["Title"] = "Editar Vehículo";
}

<div class="row justify-content-center mt-4 mb-4">
    <div class="col-12 col-lg-9 col-xl-8">
    <div class="mb-3">
        <a asp-action="Detalle" asp-route-id="@Model.IdVehiculo" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver al vehiculo
        </a>
    </div>

    <div class="text-center mb-4">
        <i class="bi bi-pencil-square" style="font-size: 3rem; color: var(--jm-azul);"></i>
         <h2 class="mt-2 mb-1">Editar publicación</h2>
         <div class="text-muted small">Podés actualizar los datos de tu vehículo, cambiar la foto y reubicarlo en el mapa.</div>
    </div> 
   
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Editar" asp-route-id="@Model.IdVehiculo" method="post" enctype="multipart/form-data" class="card card-body p-4">

        <input type="hidden" id="latitudInput" name="Latitud" value="@Model.Latitud?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <input type="hidden" id="longitudInput" name="Longitud" value="@Model.Longitud?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Precio (USD)</label>
                <input type="number" name="Precio" class="form-control" value="@((int)Model.Precio)" step="1" min="0" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Kilómetros</label>
                <input type="number" name="Km" class="form-control" value="@Model.Km" required />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Marca del Auto</label>
                <input type="text" name="Marca.Nombre" class="form-control" value="@Model.Modelo?.Marca?.NombreMarca" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Modelo del Auto</label>
                <input type="text" name="Modelo.Nombre" class="form-control" value="@Model.Modelo?.Modelo" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Año</label>
                <input type="number" name="Anio" class="form-control" value="@Model.Anio" required />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Motorización</label>
                <input type="text" name="Motorizacion" class="form-control" value="@Model.Motorizacion" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label fw-semibold">Caja de Cambios</label>
                <select name="CajaCambios" class="form-select" required>
                    <option value="">Seleccione tipo...</option>
                    <option value="Manual" selected="@(Model.CajaCambios == "Manual")">Manual</option>
                    <option value="Automática" selected="@(Model.CajaCambios != null && Model.CajaCambios.StartsWith("Autom", StringComparison.OrdinalIgnoreCase))">Automática</option>
                </select>
            </div>

        </div>

        @if (Model.Fotografia != null && Model.Fotografia.Any())
        {
            <div class="mb-3">
                <label class="form-label fw-semibold">Fotos actuales</label>
                <div class="small text-muted mb-2">Destildá lo que querés sacar</div>
                <div class="d-flex flex-wrap gap-3">
                    @for (int i = 0; i < Model.Fotografia.Count; i++)
                    {
                        <div class="text-center">
                            <img src="/@Model.Fotografia[i]" alt="Foto del vehículo" class="img-thumbnail" style="height: 120px; object-fit: contain;" />
                            <div class="form-check d-flex justify-content-center gap-2 mt-1">
                                <input class="form-check-input" type="checkbox" name="fotosExistentes" value="@Model.Fotografia[i]" id="foto-@i" checked />
                                <label class="form-check-label small" for="foto-@i">Mantener</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="mb-3">
            <label class="form-label fw-semibold">Agregar fotos nuevas</label>
            <input type="file" name="fotoInput" class="form-control" accept="image/*" multiple />
            <div class="form-text">Opcional. Se suman a las fotos que dejes marcadas arriba.</div>
        </div>


        <div class="mb-4">
            <label class="form-label fw-semibold">Descripción / Detalles adicionales</label>
            <textarea name="Descripcion" class="form-control" rows="4" required>@Model.Descripcion</textarea>
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold">
                <i class="bi bi-geo-alt" style="color: var(--jm-azul);"></i>Ubicación de Entrega / Exhibición
            </label>
            <p class="small text-muted mb-0">Hacé un clic en el mapa para actualizar el punto donde se encuentra el auto.</p>

            <div id="map" class="border rounded mt-2 shadow-sm" style="height: 380px; background-color: #f8f9fa;"></div>

            <div id="coordenadasInfo" class="text-success small mt-2 font-monospace fw-bold"></div>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <a asp-action="Detalle" asp-route-id="@Model.IdVehiculo" class="btn btn-outline-secondary px-4">Cancelar</a>
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-circle"></i>Guardar Cambios
            </button>
        </div>
    </form>
</div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var latInicial = @(Model.Latitud?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "-34.85");
        var lngInicial = @(Model.Longitud?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "-56.15");

        var map = L.map('map').setView([latInicial, lngInicial], 14);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var marcadorActual = L.marker([latInicial, lngInicial]).addTo(map);
        document.getElementById('coordenadasInfo').innerHTML = "✓ Ubicación actual: Lat " + latInicial.toFixed(6) + " | Lng " + lngInicial.toFixed(6);

        map.on('click', function (evento) {
            var latitud = evento.latlng.lat;
            var longitud = evento.latlng.lng;

            document.getElementById('latitudInput').value = latitud;
            document.getElementById('longitudInput').value = longitud;

            document.getElementById('coordenadasInfo').innerHTML = "✓ Ubicación seleccionada: Lat " + latitud.toFixed(6) + " | Lng " + longitud.toFixed(6);

            map.removeLayer(marcadorActual);

            marcadorActual = L.marker([latitud, longitud]).addTo(map)
                .bindPopup("<div class='text-center'><b>¡Auto reubicado!</b><br/>Guardamos estas coordenadas.</div>")
                .openPopup();
        });
    });
</script>
