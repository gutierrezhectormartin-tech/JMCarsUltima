@model JMCarsWeb.ViewModels.MisVehiculosViewModel
@{
    string volver = Context.Request.Path.Value + Context.Request.QueryString.Value;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Mis Vehículos Publicados</h2>
            <p class="text-muted mb-0">Acá podés gestionar las publicaciones de tus automóviles en JMCars.</p>
        </div>
        <a asp-controller="Vehiculo" asp-action="Crear" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva Publicación
        </a>
    </div>

    <hr />

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-controller="Vehiculo" asp-action="MisVehiculos" method="get" class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Marca, modelo o año"/>
        </div>
        <div class="col-md-3">
            <select name="estado" class="form-select">
                <option value="">Todos los estados</option>
                <option value="1" selected="@(Model.Estado == 1)">Pendiente</option>
                <option value="2" selected="@(Model.Estado == 2)">Aprobada</option>
                <option value="3" selected="@(Model.Estado == 3)">Rechazada</option>
                <option value="4" selected="@(Model.Estado == 4)">Inactiva</option>
                <option value="5" selected="@(Model.Estado == 5)">En Tramite</option>
                <option value="6" selected="@(Model.Estado == 6)">Vendido</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-1">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-controller="Vehiculo" asp-action="MisVehiculos" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="text-muted small mb-2">@Model.TotalFiltrados resultado(s)</div>

    @if (Model.Vehiculos == null || !Model.Vehiculos.Any())
    {
        @if(Model.Estado.HasValue || !string.IsNullOrWhiteSpace(Model.Buscar))
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i> No hay vehiculos con estos filtros
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i> Todavía no tenés ningún vehículo publicado en la plataforma.
            </div>
        }

    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 90px;">Foto</th>
                        <th>Vehículo</th>
                        <th>Kilometraje</th>
                        <th>Precio</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vehiculo in Model.Vehiculos)
                    {
                        <tr>
                            <!-- 1. FOTO CORREGIDA -->
                            <td>
                                @if (vehiculo.Fotografia != null && vehiculo.Fotografia.Any())
                                {
                                    // Limpiamos la ruta por si viene con barras invertidas de Windows (\)
                                    string primeraFoto = vehiculo.Fotografia.FirstOrDefault().Replace("\\", "/");
                                    string rutaFinal = primeraFoto.StartsWith("/") ? primeraFoto : "/" + primeraFoto;

                                    <img src="@rutaFinal" alt="Foto vehículo" style="width: 80px; height: 50px; object-fit: cover;" class="img-thumbnail" />
                                }
                                else
                                {
                                    <span class="text-muted small">Sin foto</span>
                                }
                            </td>

                            <!-- Marca y Modelo -->
                            <td>
                                <strong>@vehiculo.Modelo?.Marca?.NombreMarca @vehiculo.Modelo?.Modelo</strong>
                                <div class="text-muted small">Año: @vehiculo.Anio</div>
                            </td>

                            <!-- Kilometraje -->
                            <td>@vehiculo.Km.ToString("N0") Km</td>

                            <!-- Precio -->
                            <td><span class="fw-bold">U$S @vehiculo.Precio.ToString("N0")</span></td>

                            <!-- Estado -->
                            <td class="text-center">
                                @if (vehiculo.IdEstadoPublicacion == 1)
                                {
                                    <span class="badge bg-warning"><i class="bi bi-clock"></i> Pendiente</span>
                                }
                                else if (vehiculo.IdEstadoPublicacion == 2)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Aprobada</span>
                                }
                                else if (vehiculo.IdEstadoPublicacion == 3)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Rechazada</span>
                                }
                                else if (vehiculo.IdEstadoPublicacion == 4)
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-slash-circle"></i> Inactiva</span>
                                }
                                else if (vehiculo.IdEstadoPublicacion == 5)
                                {
                                    <span class="badge bg-info"><i class="bi bi-hourglass-split"></i> En Trámite</span>
                                }
                                else if (vehiculo.IdEstadoPublicacion == 6)
                                {
                                    <span class="badge bg-dark"><i class="bi bi-bag-check"></i> Vendido</span>
                                }
                            </td>

                            <!-- 2. ACCIONES CON ÍCONOS -->
                            <td class="text-center">
                                <div class="d-inline-flex gap-1">
                                    <a asp-controller="Vehiculo" asp-action="Detalle" asp-route-id="@vehiculo.IdVehiculo" class="btn btn-outline-info" title="Ver Detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (vehiculo.IdEstadoPublicacion != 5 && vehiculo.IdEstadoPublicacion != 6)
                                    {
                                        <a asp-controller="Vehiculo" asp-action="Editar" asp-route-id="@vehiculo.IdVehiculo" class="btn btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }


                                    @if (vehiculo.IdEstadoPublicacion == 1 || vehiculo.IdEstadoPublicacion == 2)
                                    {
                                        <form asp-controller="Vehiculo" asp-action="Inactivar" asp-route-id="@vehiculo.IdVehiculo" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@volver" />
                                            <button type="submit" class="btn btn-outline-warning" title="Inactivar">
                                                <i class="bi bi-toggle-on"></i>
                                            </button>
                                        </form>
                                    }
                                    else if(vehiculo.IdEstadoPublicacion == 4)
                                    {
                                        <form asp-controller="Vehiculo" asp-action="Activar" asp-route-id="@vehiculo.IdVehiculo" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnUrl" value="@volver"/>
                                            <button type="submit" class="btn btn-outline-success" title="Activar">
                                                <i class="bi bi-toggle-off"></i>
                                            </button>
                                        </form>
                                    }

                                    <a asp-controller="Chat" asp-action="ConsultasVehiculo" asp-route-idvehiculo="@vehiculo.IdVehiculo" class="btn btn-outline-info" title="Ver Consultas">
                                        <i class="bi bi-chat-dots"></i>
                                    </a>
                                </div>
                            </td>
                            
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Paginador" model="Model.Vehiculos"/>
    }
</div>