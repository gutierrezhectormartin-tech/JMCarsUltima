@model List<JMCarsWeb.DTOs.VehiculoDTO>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Mis Vehículos Publicados</h2>
            <p class="text-muted mb-0">Acá podés gestionar las publicaciones de tus automóviles en JMCars.</p>
        </div>
        <a asp-controller="Vehiculo" asp-action="Crear" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Nueva Publicación
        </a>
    </div>

    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> Todavía no tenés ningún vehículo publicado en la plataforma.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 90px;">Foto</th>
                        <th>Vehículo</th>
                        <th>Kilometraje</th>
                        <th>Precio</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vehiculo in Model)
                    {
                        <tr>
                            <!-- 1. FOTO CORREGIDA -->
                            <td>
                                @if (vehiculo.Fotografia != null && vehiculo.Fotografia.Any())
                                {
                                    // Limpiamos la ruta por si viene con barras invertidas de Windows (\)
                                    string primeraFoto = vehiculo.Fotografia.FirstOrDefault().Replace("\\", "/");
                                    string rutaFinal = primeraFoto.StartsWith("/") ? primeraFoto : "/" + primeraFoto;

                                    <img src="@rutaFinal" alt="Foto vehículo" style="width: 80px; height: 50px; object-fit: cover;" class="img-thumbnail" />
                                }
                                else
                                {
                                    <span class="text-muted small">Sin foto</span>
                                }
                            </td>

                            <!-- Marca y Modelo -->
                            <td>
                                <strong>@vehiculo.Modelo?.Marca?.NombreMarca @vehiculo.Modelo?.Modelo</strong>
                                <div class="text-muted small">Año: @vehiculo.Anio</div>
                            </td>

                            <!-- Kilometraje -->
                            <td>@vehiculo.Km.ToString("N0") Km</td>

                            <!-- Precio -->
                            <td><span class="text-success fw-bold">U$S @vehiculo.Precio.ToString("N0")</span></td>

                            <!-- Estado -->
                            <td class="text-center">
                                @if (vehiculo.Publicado)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-slash-circle"></i> Inactivo</span>
                                }
                            </td>

                            <!-- 2. ACCIONES CON ÍCONOS -->
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-controller="Vehiculo" asp-action="Detalle" asp-route-id="@vehiculo.IdVehiculo" class="btn btn-outline-info" title="Ver Detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-controller="Vehiculo" asp-action="Editar" asp-route-id="@vehiculo.IdVehiculo" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (vehiculo.Publicado)
                                    {
                                        <form asp-controller="Vehiculo" asp-action="Inactivar" asp-route-id="@vehiculo.IdVehiculo" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Desactivar">
                                                <i class="bi bi-toggle-on"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Vehiculo" asp-action="Inactivar" asp-route-id="@vehiculo.IdVehiculo" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Activar">
                                                <i class="bi bi-toggle-off"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>