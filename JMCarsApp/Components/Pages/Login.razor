@page "/login"
@using JMCarsApp.DTOs
@using JMCarsApp.Services
@using JMCarsApp.ViewModels
@inject UsuarioService ServicioUsuario
@inject SessionService Sesion
@inject NavigationManager Navegacion

<PageTitle>Iniciar sesion</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-7 col-lg-5 col-xl-4">

        @if(!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="card card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-person-circle" style="font-size: 3rem; color: var(--jm-azul);"></i>
                <h2 class="mt-2 mb-1">Iniciar Sesion</h2>
                <div class="text-muted small">Ingresa con tu Email y Contrasñea</div>
            </div>

            <EditForm Model="modelo" OnValidSubmit="IniciarSesion">
                <DataAnnotationsValidator/>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText @bind-Value="modelo.Email" type="email" class="form-control"/>
                    <ValidationMessage For="() => modelo.Email"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <InputText @bind-Value="modelo.Contrasena" type="password" class="form-control" />
                    <ValidationMessage For="() => modelo.Contrasena" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@cargando">
                    @(cargando ? "Ingresando..." : "Ingresar")
                </button>
            </EditForm>
        </div>

    </div>

</div>

@code {
    private LoginViewModel modelo = new();
    private string? error;
    private bool cargando;

    private async Task IniciarSesion()
    {
        error = null;
        cargando = true;

        try
        {
            UsuarioDTO? usuario = await ServicioUsuario.Login(modelo.Email, modelo.Contrasena);

            if(usuario == null)
            {
                error = "Datos incorrectos";
                return;
            }

            Sesion.Iniciar(usuario);
            Navegacion.NavigateTo("/");
        }
        catch(Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

}
