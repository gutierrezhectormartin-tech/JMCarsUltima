@page "/"
@using JMCarsApp.DTOs
@using JMCarsApp.Services
@inject EstadisticasService ServicioEstadisticas
@inject VehiculoService ServicioVehiculos
@inject ImagenService ServicioImagenes

<PageTitle>JMCars</PageTitle>

<section class="hero">
    <h1>Encontra tu proximo vehiculo</h1>
    <p class="mb-0">Cerca de vos. Seguro para todos. Publicaciones revisadas y cierre de la compraventa con escribano.</p>
</section>

@if(conteos != null)
{
    <div class="card mb-4">
        <div class="row g-0">
            <div class="col-6 numero-item">
                <div class="numero">@conteos.CantAprobadas</div>
                <div class="etiqueta">Vehiculos Publicados</div>
            </div>
            <div class="col-6 numero-item">
                <div class="numero">@conteos.CantVendidas</div>
                <div class="etiqueta">Vehiculos vendidos</div>
            </div>

        </div>

    </div>
}

@if(destacados.Any())
{
    <h2 class="titulo-seccion">Destacados <small>Ultimos vehiculos publicados</small></h2>
    <div class="carrusel-destacados mb-4">
        @foreach(VehiculoDTO d in destacados)
        {
            string ruta = d.Fotografia.First();
            <div class="destacado-item">
                <div class="card vehiculo-card vehiculo-card-destacada h-100">
                    <span class="etiqueta-destacado">Destacado</span>
                    @if(fotos.GetValueOrDefault(ruta) != null)
                    {
                        <img class="vehiculo-foto" src="@fotos[ruta]" alt="@d.Modelo.Marca.NombreMarca @d.Modelo.Modelo"/>
                    }
                    else
                    {
                        <div class="vehiculo-foto d-flex align-items-center justify-content-center bg-light">
                            <i class="bi bi-car-front fs-1 text-muted"></i>

                        </div>
                    }
                    <div class="card-body pb-3">
                        <h3 class="h6 mb-1">@d.Modelo.Marca.NombreMarca @d.Modelo.Modelo </h3>
                        <div class="vehiculo-datos mb-2">@d.Anio - @d.Km.ToString("N0") km - @d.CajaCambios</div>
                        <div class="vehiculo-precio">@d.Precio.ToString("C")</div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h2 class="titulo-seccion">Todos los Vehiculos <small>Filtra por marca, modelo o año</small></h2>
<div class="mb-3 text-muted small">@todos.Count @(todos.Count == 1 ? "Vehiculo" : "Vehiculos")</div>
<div class="d-flex flex-column gap-3 mb-4">
    @foreach(VehiculoDTO v in todos)
    {
        string? rutaFila = v.Fotografia?.FirstOrDefault();
        <div class="card vehiculo-fila">
            @if(rutaFila != null && fotos.GetValueOrDefault(rutaFila) != null)
            {
                <img src="@fotos[rutaFila]" alt="@v.Modelo.Marca.NombreMarca @v.Modelo.Modelo"/>
            }
            else
            {
                <div class="vehiculo-fila-sinfoto"><i class="bi bi-car-front"></i></div>
            }
            <div class="vehiculo-fila-info">
                 <h3 class="h6 mb-1">@v.Modelo.Marca.NombreMarca @v.Modelo.Modelo</h3>
                <div class="vehiculo-datos">@v.Anio - @v.Km.ToString("N0") km</div>
                <div class="vehiculo-datos">@v.CajaCambios - @v.Motorizacion</div>
                <div class="vehiculo-precio mt-1">@v.Precio.ToString("C")</div>
            </div>
        </div>
    }

</div>
@code
{
    private EstadisticasDTO? conteos;
    private List<VehiculoDTO> todos = new();    
    private List<VehiculoDTO> destacados = new();
    private Dictionary<string, string?> fotos = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            conteos = await ServicioEstadisticas.ObtenerConteos();
        }
        catch(Exception)
        {
            conteos = null;
        }
        try
        {
            List<VehiculoDTO> lista = await ServicioVehiculos.ListarPublicados();
            todos = lista;
            destacados = lista.Where(v => v.Fotografia != null && v.Fotografia.Any()).OrderByDescending(v => v.IdVehiculo).Take(6).ToList();
            StateHasChanged();
            foreach(VehiculoDTO v in lista)
            {
                if (v.Fotografia == null || !v.Fotografia.Any()) continue;

                string ruta = v.Fotografia.First();
                fotos[ruta] = await ServicioImagenes.ObtenerDataUri(ruta);
                StateHasChanged();
            }
        }
        catch(Exception)
        {
            todos = new();
            destacados = new();
        }
    }
}