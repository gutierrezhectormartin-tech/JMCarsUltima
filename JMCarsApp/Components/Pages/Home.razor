@page "/"
@using JMCarsApp.DTOs
@using JMCarsApp.Services
@inject EstadisticasService ServicioEstadisticas
@inject VehiculoService ServicioVehiculos
@inject ImagenService ServicioImagenes

<PageTitle>JMCars</PageTitle>

<section class="hero">
    <h1>Encontra tu proximo vehiculo</h1>
    <p class="mb-0">Cerca de vos. Seguro para todos. Publicaciones revisadas y cierre de la compraventa con escribano.</p>
</section>

@if(conteos != null)
{
    <div class="card mb-4">
        <div class="row g-0">
            <div class="col-6 numero-item">
                <div class="numero">@conteos.CantAprobadas</div>
                <div class="etiqueta">Vehiculos Publicados</div>
            </div>
            <div class="col-6 numero-item">
                <div class="numero">@conteos.CantVendidas</div>
                <div class="etiqueta">Vehiculos vendidos</div>
            </div>

        </div>

    </div>
}

@if(destacados.Any())
{
    <h2 class="titulo-seccion">Destacados <small>Ultimos vehiculos publicados</small></h2>

    <div class="carrusel-destacados mb-4">
        @foreach(VehiculoDTO d in destacados)
        {
            string ruta = d.Fotografia.First();
            <div class="destacado-item">
                <a class="d-block h-100 text-decoration-none text-reset" href="vehiculo/@d.IdVehiculo">
                <div class="card vehiculo-card vehiculo-card-destacada h-100">
                    <span class="etiqueta-destacado">Destacado</span>
                    @if(fotos.GetValueOrDefault(ruta) != null)
                    {
                        <img class="vehiculo-foto" src="@fotos[ruta]" alt="@d.Modelo.Marca.NombreMarca @d.Modelo.Modelo"/>
                    }
                    else
                    {
                        <div class="vehiculo-foto d-flex align-items-center justify-content-center bg-light">
                            <i class="bi bi-car-front fs-1 text-muted"></i>

                        </div>
                    }
                    <div class="card-body pb-3">
                        <h3 class="h6 mb-1">@d.Modelo.Marca.NombreMarca @d.Modelo.Modelo </h3>
                        <div class="vehiculo-datos mb-2">@d.Anio - @d.Km.ToString("N0") km - @d.CajaCambios</div>
                        <div class="vehiculo-precio">@d.Precio.ToString("C")</div>
                    </div>
                </div>
                </a>
            </div>
        }
    </div>
}

<h2 class="titulo-seccion">Todos los Vehiculos <small>Filtra por marca, modelo o año</small></h2>

<div class="card mb-3"> 
    <div class="card-body">
        <div class="row g-2">
            <div class="col-6">
                <select class="form-select" @bind="idMarca" @bind:after="AlCambiarMarca">
                    <option value="">Todas las Marcas</option>
                    @foreach(MarcaDTO marca in Marcas)
                    {
                        <option value="@marca.IdMarca">@marca.NombreMarca</option>
                    }
                </select>
            </div>
            <div class="col-6">
                <select class="form-select" @bind="idModelo">
                    <option value="">Todos los modelos</option>
                    @foreach(ModeloDTO modelo in ModelosDeMarca)
                    {
                        <option value="@modelo.IdModelo">@modelo.Modelo</option>
                    }

                </select>
            </div>
            <div class="col-6">
                <select class="form-select" @bind="anio">
                    <option value="">Todos los años</option>
                    @foreach(int a in filtros.Anios)
                    {
                        <option value="@a">@a</option>
                    }
                </select>
            </div>
            <div class="col-6">
                <select class="form-select" @bind="ordenPrecio">
                    <option value="">Orden por precio</option>
                    <option value="asc">Menor a Mayor</option>
                    <option value="desc">Mayor a Menor</option>
                </select>
            </div>
            <div class="col-6 d-grid">
                <button class="btn btn-primary" @onclick="AplicarFiltros" disabled="@cargando">Filtrar</button>
            </div>
            <div class="col-6 d-grid">
                <button class="btn btn-outline-secondary" @onclick="LimpiarFiltros" disabled="@cargando">Limpiar</button>
            </div>
        </div>
    </div>
</div>

<div class="mb-3 text-muted small">Mostrando @todos.Count de @total @(total == 1 ? "vehiculo" : "vehiculos")</div>
<div class="d-flex flex-column gap-3 mb-4">
    @foreach(VehiculoDTO v in todos)
    {
        string? rutaFila = v.Fotografia?.FirstOrDefault();
        <a class="d-block text-decoration-none text-reset" href="vehiculo/@v.IdVehiculo">
        <div class="card vehiculo-fila">
            @if(rutaFila != null && fotos.GetValueOrDefault(rutaFila) != null)
            {
                <img src="@fotos[rutaFila]" alt="@v.Modelo.Marca.NombreMarca @v.Modelo.Modelo"/>
            }
            else
            {
                <div class="vehiculo-fila-sinfoto"><i class="bi bi-car-front"></i></div>
            }
            <div class="vehiculo-fila-info">
                 <h3 class="h6 mb-1">@v.Modelo.Marca.NombreMarca @v.Modelo.Modelo</h3>
                <div class="vehiculo-datos">@v.Anio - @v.Km.ToString("N0") km</div>
                <div class="vehiculo-datos">@v.CajaCambios - @v.Motorizacion</div>
                <div class="vehiculo-precio mt-1">@v.Precio.ToString("C")</div>
            </div>
        </div>
        </a>
    }

</div>
@if(consultado && !cargando && todos.Count == 0)
{
    <div class="alert alert-light text-center">No hay vehiculos con estos filtros</div>
}
<div class="mb-3 text-muted small text-center">Mostrando @todos.Count de @total</div>
@if(hayMas)
{
    <div class="text-center mb-4">
        <button class="btn btn-primary" @onclick="CargarMas" disabled="@cargando">
            @(cargando ? "Cargando..." : "Cargar mas")
        </button>

    </div>
}
@code
{
    private const int TamanoPagina = 12;
    private EstadisticasDTO? conteos;
    private FiltrosVehiculoDTO filtros = new();
    private List<VehiculoDTO> todos = new();    
    private List<VehiculoDTO> destacados = new();
    private Dictionary<string, string?> fotos = new();

    private int? idMarca;
    private int? idModelo;
    private int? anio;
    private string? ordenPrecio;

    private int pagina = 1;
    private int total = 0;
    private bool hayMas = false;
    private bool cargando = false;
    private bool consultado = true;

    private bool HayFiltros => idMarca != null || idModelo != null || anio != null || !string.IsNullOrEmpty(ordenPrecio);
    private List<MarcaDTO> Marcas => filtros.Modelos.Select(m => m.Marca).DistinctBy(m => m.IdMarca).OrderBy(m => m.NombreMarca).ToList();
    private List<ModeloDTO> ModelosDeMarca => filtros.Modelos.Where(m => idMarca == null || m.Marca.IdMarca == idMarca).OrderBy(m => m.Modelo).ToList();


    protected override async Task OnInitializedAsync()
    {
        try
        {
            conteos = await ServicioEstadisticas.ObtenerConteos();
        }
        catch(Exception)
        {
            conteos = null;
        }
        try
        {
            filtros = await ServicioVehiculos.ListarFiltrosPublicados();
        }
        catch (Exception)
        {
            filtros = new FiltrosVehiculoDTO();
        }

        await CargarPagina();
    }

    private async Task CargarPagina()
    {
        cargando = true;
        try
        {
            PaginaDTO<VehiculoDTO> resultado = await ServicioVehiculos.ListarPublicadosPaginado(idMarca, idModelo, anio, ordenPrecio, pagina, TamanoPagina);

            total = resultado.Total;
            hayMas = resultado.HayMas;
            todos.AddRange(resultado.Items);

            if(pagina == 1 && destacados.Count == 0 && !HayFiltros)
            {
                destacados = todos.Where(v => v.Fotografia != null && v.Fotografia.Any()).OrderByDescending(v => v.IdVehiculo).Take(6).ToList();
            }
            StateHasChanged();

            foreach(VehiculoDTO v in resultado.Items)
            {
                if (v.Fotografia == null || !v.Fotografia.Any()) continue;

                string ruta = v.Fotografia.First();
                if (fotos.ContainsKey(ruta)) continue;

                fotos[ruta] = await ServicioImagenes.ObtenerDataUri(ruta);
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            hayMas = false;
        }
        finally
        {
            cargando = false;
            consultado = true;
        }

    }

    private async Task CargarMas()
    {
        pagina++;
        await CargarPagina();
    }

    private void AlCambiarMarca()
    {
        idModelo = null;
    }

    private async Task AplicarFiltros()
    {
        pagina = 1;
        todos = new();
        total = 0;
        hayMas = false;
        await CargarPagina();
    }

    private async Task LimpiarFiltros()
    {
        idMarca = null;
        idModelo = null;
        anio = null;
        ordenPrecio = null;
        await AplicarFiltros();
    }
}