@inherits LayoutComponentBase
@implements IDisposable
@using JMCarsApp.Services
@inject SessionService Sesion
@inject NavigationManager Navegacion

<header>

    <nav class="navbar navbar-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="">
                <i class="bi bi-car-front-fill me-2"></i>JMCars
            </a>

            <div>
                @if (!Sesion.EstadoLogueado)
                {
                    <a class="btn btn-outline-light" href="login">Iniciar Sesion</a>
                }
                else
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-light" @onclick="AlternarMenu">
                            <i class="bi bi-person-circle me-1"></i>Hola, @Sesion.Usuario!.NombreCompleto <i class="bi bi-caret-down-fill small"></i>
                        </button>
                        @if (menuAbierto)
                        {
                            <div style="position: fixed; inset: 0; z-index: 999;" @onclick="CerrarMenu"></div>
                            <ul class="dropdown-menu show" style="right: 0; left: auto; top: 100%; z-index: 1000;">
                                @if(RutaPerfil != null)
                                {
                                    <li><a class="dropdown-item" href="@RutaPerfil" @onclick="CerrarMenu"><i class="bi bi-person me-2"></i>Mi Perfil</a></li>
                                    <li><hr class="dropdown-divider"/></li>
                                }
                                @if (Sesion.EsEscribano)
                                {
                                    <li><a class="dropdown-item" href="solicitudes/escribano" @onclick="CerrarMenu"><i class="bi bi-file-earmark-text me-2"></i>Solicitudes recibidas</a></li>
                                    <li><hr class="dropdown-divider"/></li>
                                }
                                <li><button class="dropdown-item" @onclick="CerrarSesion"><i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesion</button></li>
                            </ul>
                        }
                    </div>
                }
            </div>

        </div>
    </nav>

</header>

<main class="container flex-grow-1">
    @Body
</main>

<footer class="pie-pagina">
    <div class="container text-center">
        © @DateTime.Now.Year JMCars - Cerca de vos. Seguro para todos
    </div>
</footer>

@code
{
    private bool menuAbierto = false;
    private string? RutaPerfil => Sesion.EsCliente ? "perfil/cliente" : Sesion.EsEscribano ? "perfil/escribano" : null;

    private void AlternarMenu()
    {
        menuAbierto = !menuAbierto;
    }

    private void CerrarMenu()
    {
        menuAbierto = false;
    }
    protected override void OnInitialized()
    {
        Sesion.CambioSesion += AlCambiarSesion;
    }
    private void AlCambiarSesion()
    {
        InvokeAsync(StateHasChanged);
    }
    private void CerrarSesion()
    {
        menuAbierto = false;
        Sesion.Cerrar();
        Navegacion.NavigateTo("/");
    }
    public void Dispose()
    {
        Sesion.CambioSesion -= AlCambiarSesion;
    }
}
